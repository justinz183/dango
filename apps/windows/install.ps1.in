# Installs DANGO for Windows (preview) from PowerShell:
#
#   irm https://dangoai.org/install.ps1 | iex
#
# Downloads the Dango @VERSION@ installer (64-bit Windows 10 1803 or later),
# checks it against the SHA-256 below, installs it for you only (no
# administrator rights, in %LOCALAPPDATA%\Dango) and opens it. Running it
# again updates an installed copy. A file downloaded this way carries no
# "from the internet" mark, so SmartScreen does not stop the unsigned
# installer the way it stops one downloaded in a browser.
#
# $env:DANGO_NO_OPEN = "1" does not open the app afterwards;
# $env:DANGO_URL = "<base>" downloads from another address.
#
# Generated by tools/release.sh from apps/windows/install.ps1.in.
& {
  $ErrorActionPreference = 'Stop'
  $ProgressPreference = 'SilentlyContinue'   # Invoke-WebRequest crawls while it draws a progress bar
  $Version = '@VERSION@'
  $Exe = '@EXE@'
  $Sha256 = '@SHA256@'
  $Base = if ($env:DANGO_URL) { $env:DANGO_URL.TrimEnd('/') } else { '@BASE_URL@' }
  $zh = (Get-UICulture).Name -like 'zh*'
  # One line in the reader's language.
  function Say([string]$zhText, [string]$enText) { if ($zh) { Write-Host $zhText } else { Write-Host $enText } }
  function Fail([string]$zhText, [string]$enText) { if ($zh) { throw $zhText } else { throw $enText } }

  if (-not [Environment]::Is64BitOperatingSystem) { Fail 'DANGO 只支持 64 位 Windows。' 'DANGO needs 64-bit Windows.' }
  if ([Environment]::OSVersion.Version.Build -lt 17134) { Fail 'DANGO 需要 Windows 10 1803 或更新的系统。' 'DANGO needs Windows 10 version 1803 or later.' }

  $tmp = Join-Path ([IO.Path]::GetTempPath()) ('dango-' + [guid]::NewGuid().ToString('N'))
  New-Item -ItemType Directory -Path $tmp | Out-Null
  try {
    $file = Join-Path $tmp $Exe
    Say "正在下载 DANGO $Version…" "Downloading DANGO $Version…"
    try { Invoke-WebRequest -Uri "$Base/$Exe" -OutFile $file -UseBasicParsing }
    catch { Fail "下载失败：$Base/$Exe" "Download failed: $Base/$Exe" }
    $got = (Get-FileHash -Algorithm SHA256 -Path $file).Hash.ToLowerInvariant()
    if ($got -ne $Sha256) { Fail '下载的文件和校验值对不上，已停止，什么都没装。' 'The download does not match its checksum; stopped, nothing installed.' }

    # An update: the installer replaces Dango.exe, which both the app and its
    # background count (Dango.exe --daemon) run from, so both stop first. The
    # app starts the background count again when it opens.
    Get-Process -Name Dango -ErrorAction SilentlyContinue | Stop-Process -Force
    Start-Sleep -Milliseconds 500
    $p = Start-Process -FilePath $file -ArgumentList '/S' -Wait -PassThru
    $app = Join-Path $env:LOCALAPPDATA 'Dango\Dango.exe'
    if ($p.ExitCode -ne 0 -or -not (Test-Path $app)) { Fail "安装没有完成（退出码 $($p.ExitCode)）。" "The installer did not finish (exit code $($p.ExitCode))." }
    Say "已装好：$app" "Installed: $app"

    if ($env:DANGO_NO_OPEN -ne '1') {
      Start-Process -FilePath $app
      Say '团子在屏幕右下角，先读一遍你的 Claude Code 和 Codex 历史，之后在后台一直记着。' `
          'The dango is in the bottom-right corner. It reads your Claude Code and Codex history first, then keeps count in the background.'
    }
  }
  finally { Remove-Item -Recurse -Force $tmp -ErrorAction SilentlyContinue }
}
