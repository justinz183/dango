#!/bin/sh
# Installs DANGO (Dango.app) from the command line:
#
#   curl -fsSL @BASE_URL@/install.sh | sh
#
# Downloads Dango @VERSION@ (Apple silicon and Intel, macOS 13 or later),
# checks it against the SHA-256 below, puts it in /Applications (or
# ~/Applications when /Applications is not writable) and opens it. Running
# it again updates an installed copy. On first launch the app sets up its
# background helper, reads your Claude Code and Codex history on this Mac
# and invites you to see your ABTI; nothing is uploaded.
#
# DANGO_APP_DIR=<folder> installs elsewhere; DANGO_NO_OPEN=1 does not open
# the app afterwards; DANGO_URL=<base> downloads from another address.
#
# Generated by apps/widget/package.sh from apps/widget/install.sh.in.
set -eu

VERSION="@VERSION@"
ZIP="Dango-@VERSION@.zip"
SHA256="@SHA256@"
BASE="${DANGO_URL:-@BASE_URL@}"

case "${LC_ALL:-}${LC_MESSAGES:-}${LANG:-}" in
  zh*|*:zh*) zh=1 ;;
  *) zh=0 ;;
esac
# One line in the reader's language.
say() { if [ "$zh" = 1 ]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }
fail() { say "$1" "$2" >&2; exit 1; }

[ "$(uname -s)" = Darwin ] || fail "DANGO 只支持 macOS。" "DANGO runs on macOS only."
major="$(sw_vers -productVersion | cut -d. -f1)"
[ "$major" -ge 13 ] 2>/dev/null || fail "DANGO 需要 macOS 13 或更新的系统。" "DANGO needs macOS 13 or later."

dest="${DANGO_APP_DIR:-}"
if [ -z "$dest" ]; then
  if [ -w /Applications ]; then dest=/Applications; else dest="$HOME/Applications"; fi
fi
mkdir -p "$dest"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT INT TERM

say "正在下载 DANGO ${VERSION}…" "Downloading DANGO ${VERSION}…"
curl -fL --progress-bar "$BASE/$ZIP" -o "$tmp/$ZIP" || fail "下载失败：$BASE/$ZIP" "Download failed: $BASE/$ZIP"
got="$(shasum -a 256 "$tmp/$ZIP" | cut -d' ' -f1)"
[ "$got" = "$SHA256" ] || fail "下载的文件和校验值对不上，已停止，什么都没装。" "The download does not match its checksum; stopped, nothing installed."
ditto -x -k "$tmp/$ZIP" "$tmp/x"
[ -d "$tmp/x/Dango.app" ] || fail "安装包里没有 Dango.app。" "No Dango.app in the download."

# An update: quit the running copy first (a plain signal: asking it over
# AppleScript would make macOS ask the person for permission). Its
# background helper keeps running and restarts on the new version when the
# app opens.
if pgrep -x Dango >/dev/null 2>&1; then
  pkill -x Dango 2>/dev/null || true
  sleep 1
fi
rm -rf "$dest/Dango.app"
ditto "$tmp/x/Dango.app" "$dest/Dango.app"
say "已装好：$dest/Dango.app" "Installed: $dest/Dango.app"

if [ "${DANGO_NO_OPEN:-}" != 1 ]; then
  open "$dest/Dango.app"
  say "团子在屏幕右下角，先读一遍你的 Claude Code 和 Codex 历史，读完会邀请你看你的 ABTI 人格。" \
      "The dango is in the bottom-right corner. It reads your Claude Code and Codex history first, then invites you to see your ABTI."
fi
