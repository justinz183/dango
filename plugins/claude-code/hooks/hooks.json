{
  "description": "Dango: prices finished agent work by who you would have hired.",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit|Bash|Agent|Task|WebSearch|WebFetch|mcp__.*", "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }
    ],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "dango hook", "timeout": 5 }] }],
    "Notification": [
      { "matcher": "permission_prompt", "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }
    ],
    "PreCompact": [{ "hooks": [{ "type": "command", "command": "dango hook", "async": true }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "dango hook", "timeout": 5 }] }]
  }
}
